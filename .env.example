# Copy this file to .env and adjust it.
# FreshRSS address as seen from the container, WITHOUT a trailing slash:
# - FreshRSS on the same host: http://<host-ip>:<FreshRSS host port>
# - or simply FreshRSS's public URL: https://freshrss.example.com
FRESHRSS_URL=http://192.168.1.10:8080

# Push notifications (true/false)
NOTIFICATIONS=true

# Contact address given to push services (Google, Mozilla...) with notifications
#VAPID_SUBJECT=mailto:you@example.com
