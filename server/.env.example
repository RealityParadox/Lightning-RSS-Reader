# FreshRSS address as seen from the reader container, WITHOUT a trailing slash.
# Copy this file to .env and adjust it.
# - another container on the same host: http://<host-ip>:<FreshRSS host port>
# - or simply FreshRSS's public URL: https://freshrss.example.com
FRESHRSS_UPSTREAM=http://192.168.1.10:8080
